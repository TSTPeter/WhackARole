{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "packageName": "com.renault.teamsynergy",
  "developer": {
    "name": "Renault",
    "websiteUrl": "https://www.renault.com",
    "privacyUrl": "https://www.renault.com/privacy",
    "termsOfUseUrl": "https://www.renault.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Team Synergy",
    "full": "Team Synergy - Diversity Card Game"
  },
  "description": {
    "short": "Experience the power of diverse teams through an engaging card game",
    "full": "Team Synergy is an interactive trick-based card game that demonstrates how diverse teams solve complex engineering challenges more effectively. Players build teams with varied skills, perspectives, experiences, and backgrounds to earn bonus points and win challenges."
  },
  "accentColor": "#FFCC00",
  "configurableTabs": [
    {
      "configurationUrl": "https://{{YOUR_DOMAIN}}/diversity-game/teams-config.html",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupchat"]
    }
  ],
  "staticTabs": [
    {
      "entityId": "teamsynergy",
      "name": "Team Synergy",
      "contentUrl": "https://{{YOUR_DOMAIN}}/diversity-game/index.html",
      "websiteUrl": "https://{{YOUR_DOMAIN}}/diversity-game/index.html",
      "scopes": ["personal"]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "{{YOUR_DOMAIN}}"
  ],
  "webApplicationInfo": {
    "id": "{{AAD_APP_ID}}",
    "resource": "api://{{YOUR_DOMAIN}}/{{AAD_APP_ID}}"
  }
}
